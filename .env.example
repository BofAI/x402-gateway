# Gateway service
X402_GATEWAY_PORT=4020
X402_GATEWAY_PROVIDERS_HOST_DIR=./providers
X402_GATEWAY_PUBLIC_BASE_URL=http://host.docker.internal:4020
X402_GATEWAY_BUILD_COMMIT=local
X402_GATEWAY_MAX_RESPONSE_BYTES=20000000
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_API_KEY=
X402_PROVIDER_RECIPIENT_BSC_TESTNET=
X402_PROVIDER_RECIPIENT_TRON=
X402_PROVIDER_FORWARD_URL=https://api.example.com
X402_PROVIDER_API_TOKEN=
X402_PROVIDER_RECIPIENT_BASE=0x0000000000000000000000000000000000000001

# Provider upstream secrets referenced by provider.yml auth blocks.
# Keep real values in .env or the production secret manager.
BANKOFAI_API_KEY=
# TRON_GRID_API_KEY=

# Public URL used by external clients.
